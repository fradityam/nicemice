// Cloudflare Worker "nicemice" (nicemice.id). Workers Builds deploys it from GitHub main.
// The site is a static single-page app: Vite builds it into dist/ and the Worker serves
// those files. Any path that isn't a file (a couple's /radit-ratu, /template/friends, …)
// gets index.html, and the app's router shows the right page or its own "not found".
//
// worker/index.ts runs first for page URLs so a couple's page gets their own link-preview
// tags (WhatsApp doesn't run JavaScript). Built files, couple photos and music skip it.
{
  "name": "nicemice",
  "compatibility_date": "2026-10-01",
  "main": "worker/index.ts",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/*", "!/assets/*", "!/couples/*", "!/*.*"]
  }
}
